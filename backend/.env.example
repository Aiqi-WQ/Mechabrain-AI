# ===== 机小智 MechaBrain AI · 服务端配置模板 =====
# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。

# --- 文本模型：DeepSeek（https://platform.deepseek.com/api_keys） ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
CHAT_TEMPERATURE=0.3

# --- 多模态：通义千问 qwen-vl-max（https://bailian.console.aliyun.com） ---
DASHSCOPE_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-max

# --- 检索：默认关闭 Chroma，使用内置 BM25 ---
CHROMA_ENABLED=false
CHROMA_DIR=./data/chroma
INDEX_FILE=./data/index.json

# 启用向量检索时填写 embedding 服务（bge-m3，OpenAI 兼容 /embeddings 接口）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
RETRIEVE_TOP_K=5

# --- 服务 ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=10
RATE_LIMIT_PER_MIN=30
